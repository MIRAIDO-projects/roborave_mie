---
import { generateJsonLd } from "../../utils/jsonLdGenerator";

interface Props {
    title: string;
    description: string;
    image?: string;
    imageAlt?: string; // AI Accessibility optimization
    type?: "website" | "article" | "product";
    canonicalUrl?: string;
    publishDate?: string;
    authorName?: string;
}

const {
    title,
    description,
    image = "/og-default.png", // Fallback image
    imageAlt = "Site default description for AI", // Fallback accessible description for AI
    type = "website",
    canonicalUrl = Astro.url.href,
    publishDate,
    authorName,
} = Astro.props;

// Generate structured data
const jsonLd = generateJsonLd({
    type,
    url: Astro.url.href,
    title,
    description,
    image,
    publishDate,
    modifiedDate: new Date().toISOString(), // Example: use now or pass from props
    author: authorName ? { name: authorName } : undefined,
});
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url.href} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />
<meta property="twitter:image:alt" content={imageAlt} />

<!-- JSON-LD Structured Data (for AI/Search Engines) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
