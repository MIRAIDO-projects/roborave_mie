---

<footer
    class="bg-black text-white py-12 border-t-4 border-black relative overflow-hidden"
>
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-20 pointer-events-none bg-noise"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div
            class="flex flex-col md:flex-row justify-between items-center gap-8"
        >
            <div class="text-center md:text-left">
                <div class="font-black text-2xl tracking-tighter mb-2">
                    ROBORAVE MIE
                </div>
                <p class="text-gray-400 text-sm">
                    &copy; {new Date().getFullYear()} RoboRAVE Mie. All rights reserved.
                </p>
            </div>

            <div
                class="flex flex-wrap justify-center gap-6 font-bold text-sm tracking-wide uppercase"
            >
                <a
                    href="/privacy-policy"
                    class="hover:text-swiss-red transition-colors duration-300"
                >
                    Privacy Policy
                </a>
                <a
                    href="/terms-of-use"
                    class="hover:text-swiss-red transition-colors duration-300"
                >
                    Terms of Use
                </a>
                <a
                    href="/legal"
                    class="hover:text-swiss-red transition-colors duration-300"
                >
                    Legal
                </a>
            </div>
        </div>
    </div>
</footer>
