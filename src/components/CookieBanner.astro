---
/**
 * CookieBanner.astro
 *
 * Cookie consent banner with Tailwind CSS, GSAP, and Google Tag Manager (Consent Mode v2) integration.
 * Compliant with Astro View Transitions.
 */

// Interface for microCMS data (Simulation)
interface CookieConsentData {
    text: string;
    agreeLabel: string;
    denyLabel: string;
}

// Mock Data (defined at the top as requested)
const cookieData: CookieConsentData = {
    text: "当サイトではUX向上のためにCookieを使用します。設定を変更せずに利用を続けることで、Cookieの使用に同意したものとみなされます。",
    agreeLabel: "同意する",
    denyLabel: "拒否する",
};
---

<div
    id="cookie-banner"
    class="fixed bottom-0 left-0 w-full z-[100] invisible opacity-0 translate-y-full"
    aria-hidden="true"
>
    <!-- Background with blur and transparency -->
    <div
        class="absolute inset-0 bg-white/95 backdrop-blur-sm shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] border-t border-gray-200"
    >
    </div>

    <!-- Content Container -->
    <div
        class="relative container mx-auto px-4 py-6 md:py-4 flex flex-col md:flex-row items-center justify-between gap-4 md:gap-8"
    >
        <!-- Text Section -->
        <p
            class="text-xs text-gray-600 leading-relaxed text-center md:text-left flex-1 font-sans"
        >
            {cookieData.text}
        </p>

        <!-- Buttons Section -->
        <div
            class="flex flex-row items-center gap-3 shrink-0 w-full md:w-auto justify-center md:justify-end"
        >
            <!-- Deny Button -->
            <button
                id="cookie-deny"
                type="button"
                class="px-4 py-2.5 text-xs md:text-sm font-medium text-gray-500 bg-transparent border border-gray-300 rounded hover:bg-gray-100 hover:text-gray-700 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2"
            >
                {cookieData.denyLabel}
            </button>

            <!-- Agree Button -->
            <button
                id="cookie-agree"
                type="button"
                class="px-6 py-2.5 text-xs md:text-sm font-bold text-white bg-indigo-600 border border-transparent rounded shadow-sm hover:bg-indigo-700 hover:shadow-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transform hover:-translate-y-0.5"
            >
                {cookieData.agreeLabel}
            </button>
        </div>
    </div>
</div>

<script>
    import { gsap } from "gsap";

    /**
     * Initialize Cookie Consent Logic
     */
    const initCookieBanner = () => {
        const banner = document.getElementById("cookie-banner");
        const agreeBtn = document.getElementById("cookie-agree");
        const denyBtn = document.getElementById("cookie-deny");

        // Safety check
        if (!banner || !agreeBtn || !denyBtn) return;

        // 1. Check LocalStorage (Effect: Don't show if set)
        const savedConsent = localStorage.getItem("site_consent_status"); // 'granted' | 'denied'

        if (savedConsent) {
            // Already decided: Ensure hidden and exit
            banner.style.display = "none";
            return;
        }

        // 2. In-Animation (GSAP)
        // Delay 1.0s, Slide up
        gsap.to(banner, {
            duration: 0.8,
            delay: 1.0,
            autoAlpha: 1, // visible + opacity: 1
            y: 0,
            ease: "power3.out",
            onStart: () => {
                banner.setAttribute("aria-hidden", "false");
            },
        });

        /**
         * Handle Consent Action
         * @param status 'granted' | 'denied'
         */
        const handleConsent = (status: "granted" | "denied") => {
            // GTM Consent Mode v2 Update
            if (typeof window.gtag === "function") {
                window.gtag("consent", "update", {
                    ad_storage: status,
                    ad_user_data: status,
                    ad_personalization: status,
                    analytics_storage: status,
                });

                // Push event
                if (window.dataLayer) {
                    window.dataLayer.push({ event: "consent_updated" });
                }
            } else {
                console.warn(
                    "GTM (window.gtag) not found. Consent stored locally only.",
                );
            }

            // Save preference
            localStorage.setItem("site_consent_status", status);

            // Out-Animation (GSAP)
            gsap.to(banner, {
                y: "100%",
                opacity: 0,
                duration: 0.5,
                ease: "power3.in",
                onComplete: () => {
                    banner.style.display = "none";
                    banner.setAttribute("aria-hidden", "true");
                },
            });
        };

        // Attach Listeners
        // Use proper typing for Event
        agreeBtn.onclick = () => handleConsent("granted");
        denyBtn.onclick = () => handleConsent("denied");
    };

    // 3. Robust Initialization (Works with and without View Transitions)
    const init = () => {
        initCookieBanner();
    };

    // Run on initial load
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }

    // Re-run on Astro View Transitions (if enabled)
    document.addEventListener("astro:page-load", init);
</script>
